          <profiles>
            <profile name="Convergence Stimulant" id="c803-bec7-cbb5-af4e" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">Once per turning point, a friendly **VESPID STINGWING** operative can perform the **Pick Up Marker** or a mission action without you spending a Communion point.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Neurostimulant" id="b75b-1d31-ad42-b445" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="27ee-67f8-0433-b607" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Neurostimulant" id="9c67-dc6b-0183-1cc2" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">In the Ready step of each Strategy phase, when determining how many Communion points to gain, you can roll two D3 and select one D3 to use.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Accelerant Stimulant" id="e02b-1412-4fbd-607d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8381-ab8c-094b-20c3" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Accelerant Stimulant" id="59b5-8573-3e8d-2e5a" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">Whenever a friendly **VESPID STINGWING** operative (excluding **OVERSIGHT DRONE**) performs the **Charge** or **Dash** action, it can move an additional 1&quot;. If it uses **FLY** for this action, you can set it back up 1&quot; further away.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Aggression Stimulant" id="6153-a31b-881a-3b2d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cd41-93e3-2b16-7ee0" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <infoLinks>
