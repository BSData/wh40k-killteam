        <profile name="Blooded Icon" id="ddbe-af66-2275-2aa8" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Once per turning point, when a friendly BLOODED operative that has one of your Blooded tokens is incapacitated, if this operative is within 6&quot; of it, you can regain that token.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lead With Strength" id="9bfa-9eb2-6848-6469" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Whenever this operative has one of your Blooded tokens or is wholly within your opponent’s territory, treat it as if it’s under the GAZE OF THE GODS.</characteristic>
          </characteristics>
        </profile>
      </profiles>
