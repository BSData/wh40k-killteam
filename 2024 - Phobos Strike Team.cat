          </infoLinks>
          <profiles>
            <profile name="Special Issue Ammunition" id="ecb7-7e8a-3d63-f466" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">Once per turning point, when a friendly PHOBOS STRIKE TEAM operative is performing the **Shoot** action and you select a bolt carbine, marksman bolt carbine or occulus bolt carbine, you can use this rule. If you do, until the end of the turning point, that weapon has the Piercing 1 weapon rule.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Additional Utility Grenades" id="60ee-839a-170c-4f89" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8bd7-f125-14cd-5baf" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Additional Utility Grenades" id="e769-39dd-c306-ad4f" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">This equipment allows you to select four utility grenades from the utility grenades equipment (see universal equipment). You cannot also select that equipment as normal (i.e. to give you six).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Purity Seals" id="8f7f-8f3b-58e9-f0ba" hidden="false" import="true" type="upgrade">
