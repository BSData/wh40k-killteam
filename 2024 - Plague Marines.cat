  <sharedRules>
    <rule name="*Poison" id="274d-df2b-3a9b-ae57" hidden="false">
      <description>In the Resolve Attack Dice step, if you inflict damage with any successes, the operative this weapon is being used against (excluding friendly PLAGUE MARINE operatives) gains one of your Poison tokens (if it doesn’t already have one). Whenever an operative that has one of your Poison tokens is activated, inflict 1 damage on it.</description>
    </rule>
    <rule name="*Toxic" id="9506-a75a-7ca1-039a" hidden="false">
      <description>Whenever this operative is using this weapon against an enemy operative that had one of your Poison tokens at the start of that action, add 1 to both Dmg stats of this weapon.</description>
    </rule>
  </sharedRules>
