        <profile name="Grandfather&apos;s Blessing" id="bfdb-6095-48be-670d" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Whenever an enemy operative that has one of your Poison tokens loses one or more wounds within 7&quot; of this operative, this operative regains up to an equal number of lost wounds (to a maximum of 3 lost wounds per turning point, and only if this operative isn’t incapacitated).</characteristic>
          </characteristics>
        </profile>
      </profiles>
