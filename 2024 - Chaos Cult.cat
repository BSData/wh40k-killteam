        <profile name="Icon Bearer" id="74ce-95e3-d85d-9429" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Whenever determining control of a marker, treat this operative’s APL stat as 1 higher. Note this isn’t a change to its APL stat, so any changes are cumulative with this.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ruinous Icon (1AP)" id="b0f7-0d0f-21b0-4825" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">▶ PSYCHIC. Select one of the following effects to last until the start of this operative’s next activation, until it’s incapacitated or until it performs this action again (whichever comes first):
- **Invigoration**: PSYCHIC. Whenever a friendly CHAOS CULT operative is within 4&quot; of this operative, Normal and Critical Dmg of 4 or more inflicts 1 less damage on that operative.
- **Deterioration**: PSYCHIC. Whenever an enemy operative is within 4&quot; of this operative, Normal and Critical Dmg inflicts 1 more damage on that operative.
◆ This operative cannot perform this action while within control range of an enemy operative.</characteristic>
          </characteristics>
        </profile>
      </profiles>
