    <selectionEntryGroup name="Faction Equipment" id="98b5-379b-400f-3f1d" hidden="false">
      <selectionEntries>
        <selectionEntry name="Purloined Rations" id="47ae-8ef0-5d85-7246" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a27b-6e92-e2ce-5689" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Purloined Rations" id="3e4f-d2ff-91b1-0f56" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">Once per turning point, when a friendly RATLING operative is shooting with a rifle and you’ve rolled your attack dice, you can use this rule. If you do, improve the Hit stat of its rifle by 1 until the end of that sequence.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Stolen Goods" id="223b-ed9d-56a7-29a4" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1903-250c-ab2c-58b7" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Stolen Goods" id="08fa-aff4-862f-3cfe" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">At the end of the Select Operatives step, roll one D3. If the result is:
- 1, you lose 1CP.
- 2, you gain 1 CP.
- 3, your opponent loses 1CP.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Improvised Armour" id="e40b-74a2-7d69-6915" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9c1f-59cc-197e-e355" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Improvised Armour" id="ab6a-56ed-3613-50eb" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">Whenever an operative is shooting a friendly RATLING BULLGRYN or friendly RATLING OGRYN operative, defence dice results of 5+ are critical successes.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Lucky Round" id="e206-cfb5-b776-3f71" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9191-d053-dd55-c1a4" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Severe" id="3ef3-317e-c1e8-728d" hidden="false" targetId="721c-65bf-dfb7-8fa2" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Lucky Round" id="4d67-10a3-43ca-69a9" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">Once per turning point, whenever a friendly RATLING operative is shooting with a rifle and you&apos;ve rolled you attack dice, you can use this rule. If you do, that weapon has the Severe weapon rule for that sequence.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
