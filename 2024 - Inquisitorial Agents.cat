          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">▶ Select one friendly **INQUISITORIAL AGENT R-VR CYBER-MASTIFF** operative and change one of its attack patterns.</characteristic>
          </characteristics>
        </profile>
