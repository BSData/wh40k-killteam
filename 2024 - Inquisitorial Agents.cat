        <profile name="Navis Surveyor" id="c68b-5490-5a00-3326" hidden="false" typeId="5156-3fb9-39ce-7bdb" typeName="Operative">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">2</characteristic>
            <characteristic name="Move" typeId="c996-ffb3-e0b4-ecfa">6&quot;</characteristic>
            <characteristic name="Save" typeId="3241-5548-12d6-f103">4+</characteristic>
            <characteristic name="Wounds" typeId="74f9-f91c-b8fd-89d9">8</characteristic>
          </characteristics>
        </profile>
        <profile name="Wayfind (1AP)" id="1e4f-6c3c-239a-f827" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">▶ **SUPPORT**. Select one other friendly **INQUISITORIAL AGENT** operative (excluding **C.A.T. UNIT** or **GHEISTSKULL**) visible to and within 6&quot; of this operative, or visible to and within 6&quot; of a friendly **INQUISITORIAL AGENT C.A.T. UNIT** operative. Until the end of that operative’s next activation, add 1 to its APL stat. For the purposes of the Comms Device universal equipment, the operative the distance is being determined from must control that marker.
◆ This operative cannot perform this action while within control range of an enemy operative.</characteristic>
          </characteristics>
        </profile>
        <profile name="Remote Control (1AP)" id="3437-b6dd-1bfd-eaf1" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">▶ Select one friendly **INQUISITORIAL AGENT C.A.T. UNIT** operative. That operative can immediately perform one free action, but it cannot move more than 3&quot; during that action.
◆ This operative cannot perform this action while within control range of an enemy operative, or if a friendly **INQUISITORIAL AGENT C.A.T. UNIT** operative isn’t in the killzone.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
