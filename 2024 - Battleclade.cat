          <infoLinks>
            <infoLink name="Seek" id="e7e2-c072-329a-c17d" hidden="false" targetId="a33d-4e90-5794-6e20" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Gaze of the Omnissiah (1AP)" id="1883-ebd5-2ffe-bb4c" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
              <characteristics>
                <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">▶ Select one enemy operative visible to this operative. Until the end of the turning point, whenever a friendly BATTLECLADE operative is shooting that enemy operative, you can use this effect. If you do:
- That friendly operative&apos;s ranged weapons have the Seek Light weapon rule.
- That enemy operative cannot be obscured.
◆ This operative cannot perform this action while within control range of an enemy operative.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
