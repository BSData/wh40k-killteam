        <profile name="Rapid Insertion" id="25ba-f2bb-70aa-29c4" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">**STRATEGIC GAMBIT** in the first Strategy phase. Each friendly **TEMPESTUS AQUILON TROOPER** operative wholly within your drop zone can immediately perform a free **Reposition** action, but must finish that action wholly within 3&quot; of your drop zone.</characteristic>
          </characteristics>
        </profile>
        <profile name="Swift Landing" id="6a89-e981-5b8a-fe45" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">When this operative lands, you can set it up within 4&quot; of one of your Drop markers (measuring horizontal distance only), taking precedence over the normal distance requirement.</characteristic>
          </characteristics>
        </profile>
