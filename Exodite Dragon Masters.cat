        </profile>
        <profile name="Implacable Darkscale" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="3b41-3a9b-d1f4-1ae5">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">You can ignore any changes to this operative’s drakesteed fangs &amp; talons weapon’s Hit stat from being injured.</characteristic>
          </characteristics>
        </profile>
        <profile name="Leystalker Upgrades" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="c17f-556c-4d35-9dda">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">When this operative is selected for the battle, select up to two different Leystalker Upgrade rules (see Faction Rules) to be added to its datacard for the battle.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <entryLinks>
        <entryLink import="true" name="Drakesteed fangs &amp; talons" hidden="false" id="e0e9-f775-5d80-11db" type="selectionEntry" targetId="dabc-fe79-9ef4-f64b">
          <constraints>
