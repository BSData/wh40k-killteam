    <selectionEntry type="model" import="true" name="Drakolithe" hidden="false" id="d7a5-b5b2-154c-fcb8">
      <categoryLinks>
        <categoryLink name="EXODITE DRAGON MASTER" hidden="false" id="c29f-fbeb-ac55-425a" targetId="4a53-4778-4745-b2f6" primary="false"/>
