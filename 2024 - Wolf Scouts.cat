      <profiles>
        <profile name="Fenrisian Wolf" id="ba7c-5e58-3244-88a3" hidden="false" typeId="5156-3fb9-39ce-7bdb" typeName="Operative">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">2</characteristic>
            <characteristic name="Move" typeId="c996-ffb3-e0b4-ecfa">8&quot;</characteristic>
            <characteristic name="Save" typeId="3241-5548-12d6-f103">5+</characteristic>
            <characteristic name="Wounds" typeId="74f9-f91c-b8fd-89d9">9</characteristic>
          </characteristics>
        </profile>
        <profile name="Instinctive Predator" id="92b1-2f16-710d-621e" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">This operative cannot perform any actions other than **Charge**, **Fall Back**, **Fight** and **Reposition**. It cannot use any weapons that aren&apos;t on its datacard. This operative can perform the **Charge** action while it has a Conceal order.</characteristic>
          </characteristics>
        </profile>
        <profile name="Pounce" id="1cd1-d2cc-3ac4-f7d9" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Once per battle **STRATEGIC GAMBIT**. If this operative&apos;s APL stat is 2 or more, this operative can perform a free **Charge**, **Fall Back** or **Reposition** action. If it does, until the end of its next activation, subtract 1 from its APL stat and it cannot perform any of the aforementioned actions.</characteristic>
          </characteristics>
        </profile>
      </profiles>
