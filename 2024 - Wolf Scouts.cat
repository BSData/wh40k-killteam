        <profile name="Fangbearer" id="40f7-9a2f-a0d5-9888" hidden="false" typeId="5156-3fb9-39ce-7bdb" typeName="Operative">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">3</characteristic>
