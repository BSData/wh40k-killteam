            <constraint id="cd78-e7ba-7b73-e827-min" field="selections" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="cd78-e7ba-7b73-e827-max" field="selections" scope="parent" shared="true" type="max" value="1"/>
