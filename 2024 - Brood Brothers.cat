        <selectionEntry name="Cult Talisman" id="b4a3-97ee-a358-efb9" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4e19-0463-8700-d54d" field="selections" scope="parent" shared="true" type="max" value="1"/>
