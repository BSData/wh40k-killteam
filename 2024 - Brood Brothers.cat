          <profiles>
            <profile name="Cult Talisman" id="9c3e-2152-5d85-e001" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">Once per turning point, when an operative is shooting a friendly BROOD BROTHER operative (excluding PATRIARCH), in the Roll Defence Dice step, you can retain one of your normal successes as a critical success instead.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Covert Guises" id="d125-2d34-7f48-5dd5" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1d9f-e332-d171-0cc7" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Covert Guises" id="6d5a-4a45-b0ba-4f85" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">After revealing this equipment option, roll one D3. As a STRATEGIC GAMBIT in the first turning point, a number of friendly BROOD BROTHER BROODGUARD operatives equal to the result that are wholly within your drop zone can immediately perform a free **Reposition** action, but must end that move wholly within 3&quot; of your drop zone.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cult Knives" id="9563-ea4a-8351-fea3" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="368e-11ab-e191-2daf" field="selections" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Cult Knives" id="7bbe-8b2d-7468-1bc9" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">Friendly BROOD BROTHER BROODGUARD operatives have the cult knife melee weapon.</characteristic>
              </characteristics>
            </profile>
            <profile name="Cult knife" id="9378-d458-668e-c129" hidden="false" typeId="f25f-4b13-b724-d5a8" typeName="Weapons">
              <characteristics>
