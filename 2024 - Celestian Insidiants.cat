        <profile name="Inspired Strikes" id="baba-5d77-573f-8724" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Whenever this operative is INSPIRING, add 1 to the Critical Dmg stat of weapons on its datacard.</characteristic>
