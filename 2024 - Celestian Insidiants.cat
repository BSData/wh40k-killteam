        <profile name="Holy Example" id="221c-6b63-9a7a-ec89" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Once per turning point, if this operative is **INSPIRING**, you can use a firefight ploy for 0CP if this is the specified CELESTIAN INSIDIANT operative (including Command Re-roll if the attack or defence dice was rolled for this operative).</characteristic>
          </characteristics>
        </profile>
        <profile name="Spiritual Mentor (1AP)" id="b5e0-3eb1-3ea8-460d" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">▶ **SUPPORT**. Select one friendly CELESTIAN INSIDIANT operative visible to and within 6&quot; of this operative. That operative becomes **INSPIRING**.


◆ This operative cannot perform this action while within control range of an enemy operative, or more than once per turning point.</characteristic>
          </characteristics>
        </profile>
      </profiles>
