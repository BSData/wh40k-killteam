      <infoLinks>
        <infoLink name="Ceaseless" id="512d-2122-a174-7286" hidden="false" targetId="752d-ce38-c325-4b8a" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Ardour" id="9a20-5049-b7d9-95ac" hidden="false" typeId="c28e-f4e9-c361-61f0" typeName="Benediction">
          <characteristics>
            <characteristic name="Effect" typeId="ce87-574a-e461-c43e">Until the end of the battle, add 1 to that operative&apos;s APL stat. You cannot select this **BENEDICTION** for a **SUPERIOR** operative.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wrath" id="16c8-516e-fe87-c353" hidden="false" typeId="c28e-f4e9-c361-61f0" typeName="Benediction">
          <characteristics>
            <characteristic name="Effect" typeId="ce87-574a-e461-c43e">Until the end of the battle, weapons on that operative&apos;s datacard have the Ceaseless weapon rule.</characteristic>
          </characteristics>
        </profile>
        <profile name="Restoration" id="0744-b58e-845e-2701" hidden="false" typeId="c28e-f4e9-c361-61f0" typeName="Benediction">
          <characteristics>
            <characteristic name="Effect" typeId="ce87-574a-e461-c43e">That operative regains up to D3+2 lost wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Exigence" id="53b8-4b76-a5f4-f7ad" hidden="false" typeId="c28e-f4e9-c361-61f0" typeName="Benediction">
          <characteristics>
            <characteristic name="Effect" typeId="ce87-574a-e461-c43e">That operative can immediately perform a free **Charge** or **Dash** action (for the former, it cannot move more than 3&quot;), but must end that move closer to that incapacitated **INSPIRING** operative.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
